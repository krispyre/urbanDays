[sub_resource type="GDScript" id="GDScript_hm73w"]
resource_name = "findSeat"
script/source = "extends Level
@onready var anim_player: AnimationPlayer = $animPlayer
#findSeat

var fail_shown := false
var win_shown := false

func _init():
	LEVEL_DURATION_BEAT = 17 #timeout AFTER nth beat
func _level_ready() -> void:
	isFail = true
	print(beat_offset)
	level_number = 4

func _on_win() -> void:
	if win_shown:
		return
	print(\"correct\")
	isFail = false
	win_shown = true
	anim_player.play(\"showWin\")

func _on_fail() -> void:
	if fail_shown:
		return
	fail_shown = true
	print(\"false\")
	anim_player.play(\"showFail\")
#
func _on_timer_timeout():
	if isFail:
		fail.emit() # showFail via _on_fail if not already shown
	else:
		win.emit()
		
func _level_process(delta) -> void:
	if Input.is_action_just_pressed(\"action1\") and !isFail:
		
		win.emit()
		
func _on_player_body_entered(area: TileMapLayer) -> void:
	isFail = false
	print(\"yay\")

func _on_player_body_exited(area: TileMapLayer) -> void:
	isFail = true
	print(\"no\")
"

