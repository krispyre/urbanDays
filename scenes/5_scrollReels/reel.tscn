[sub_resource type="GDScript" id="GDScript_d6a6i"]
resource_name = "reelCard"
script/source = "extends TextureRect

@onready var like_bubble: AnimatedSprite2D = $likeBubble
@onready var play_btn: AnimatedSprite2D = $mask/playBtn


func _ready() -> void:
	like_bubble.hide()
	#await get_tree().create_timer(1).timeout
	#play_like_anims()
	
func play_like_anims():
	# its so simple that i dont want an anim player to do that
	like_bubble.show()
	like_bubble.play(\"like\")
	play_btn.play(\"like\")
	await play_btn.animation_finished
	play_btn.play_backwards(\"like\")
"

