[sub_resource type="GDScript" id="GDScript_w1qyk"]
resource_name = "scrollContainer"
script/source = "extends ScrollContainer

var scrolling = false
@export var list: VBoxContainer
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	grab_focus()
	
func _on_root_scroll_down():
	var card = list.get_child(1)
	animate_scroll(scroll_vertical+card.size.y+list.get_theme_constant(\"separation\"))
	print(owner.curReel)

func animate_scroll(target_pos: int) -> void:
	var tween := create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_CUBIC)
	scrolling = true
	tween.tween_property(self, \"scroll_vertical\", target_pos, 0.3)
	await tween.finished
	scrolling = false


func _on_root_scroll_up() -> void:
	var card = list.get_child(1)
	animate_scroll(scroll_vertical-card.size.y+list.get_theme_constant(\"separation\"))
	print(owner.curReel)


func _on_root_like() -> void:
	list.get_child(owner.curReel).play_like_anims()
"

