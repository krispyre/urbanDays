[sub_resource type="GDScript" id="GDScript_w1qyk"]
resource_name = "scrollContainer"
script/source = "extends ScrollContainer

var curReel = 1
@export var list: VBoxContainer
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	grab_focus()

func _process(dt):
	#todo make this event based
	var card = list.get_child(1)
	if Input.is_action_just_pressed(\"down\"):
		if curReel < list.get_child_count()-1:
			curReel+= 1
		animate_scroll(scroll_vertical+card.size.y+list.get_theme_constant(\"separation\"))
		print(curReel)
	elif Input.is_action_just_pressed(\"up\"):
		if curReel >1:
			curReel-= 1
		animate_scroll(scroll_vertical-card.size.y+list.get_theme_constant(\"separation\"))
		print(curReel)
		
	if Input.is_action_just_pressed(\"action1\"):
		like()
func like():
	list.get_child(curReel).play_like_anims()

func animate_scroll(target_pos: int, duration: float = .5) -> void:
	var tween := create_tween()
	tween.set_ease(Tween.EASE_OUT)
	tween.set_trans(Tween.TRANS_CUBIC)
	tween.tween_property(self, \"scroll_vertical\", target_pos, duration)
"

