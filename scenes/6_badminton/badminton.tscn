[sub_resource type="GDScript" id="GDScript_hk12w"]
resource_name = "badmintonFriend"
script/source = "extends AnimatedSprite2D

var first_return = true

func _ready() -> void:
	play(\"start\")
	print(animation)
	
func _on_racket_body_entered(body: Node2D) -> void:
	if first_return:
		first_return = false
		return
	play(\"hit\")
	await animation_finished
	play(\"idle\")
"

