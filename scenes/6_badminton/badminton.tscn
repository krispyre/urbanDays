[sub_resource type="GDScript" id="GDScript_aqvqw"]
resource_name = "ball"
script/source = "## https://www.reddit.com/r/godot/comments/qzsj45/parabolic_trajectory/
extends CharacterBody2D

@export var player: CharacterBody2D
@onready var spr: Sprite2D = $spr
@onready var anim_player: AnimationPlayer = $animPlayer

var hangTime = .343*3 #reah in 1sec, turn to be in beat
var target_x
var target_height

var gravity = 981
var in_range = false

#temp todo ignore bounce if its the first serve from friend
var is_first_serve = true

func _ready():
	velocity = Vector2(0,0)
	#hide()
	
func _physics_process(dt):
	if owner.game_start && !owner.isResultsShown:
		velocity.y += gravity*dt
		spr.rotation = velocity.angle()
		move_and_collide(velocity*dt)

func _on_lana_swing() -> void:
	if in_range:
		bounce()

func _on_racket_body_entered(body: Node2D) -> void:
	in_range = true

func _on_racket_body_exited(body: Node2D) -> void:
	in_range = false

func _on_friend_racket_body_entered(body: Node2D) -> void:
	if is_first_serve:
		is_first_serve = false
		return
	bounce()

func bounce():
	#still starts at enter vel
	if velocity.x > 0:
		#going back to friend
		set_init_vel(118, randi_range(60,220))
	else:
		set_init_vel(randi_range(440,620),randi_range(100,150))
	
func set_init_vel(tx, ty):
	target_x = tx
	target_height = ty
	
	velocity.x = (tx - position.x)/hangTime
	# 𝑣0𝑦=1/2*𝑔𝑡 I FORGOT PHYSICS
	velocity.y = -4*ty/hangTime
	gravity = 8*ty/hangTime/hangTime
	
func _on_badminton_game_start() -> void:
	show()
	set_init_vel(595,100)
	
func _on_floor_body_entered(body: Node2D) -> void:
	anim_player.play(\"blink\")
"

