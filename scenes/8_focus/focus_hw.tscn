[sub_resource type="GDScript" id="GDScript_dbfos"]
resource_name = "focusHw"
script/source = "extends Level

@export var focus_bar: TextureProgressBar

func _init() -> void:
	LEVEL_DURATION_BEAT=32
func _on_timer_timeout() -> void:
	game_start = false
	if abs(focus_bar.value) < focus_bar.focus_thres:
		print(\"owo\")
	else:
		print(\"umu\")
		
#func _level_process(delta: float) -> void:
	#print(focus_bar.value)
"

