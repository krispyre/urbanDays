[sub_resource type="GDScript" id="GDScript_cyp5f"]
resource_name = "focusView"
script/source = "extends AnimatedSprite2D

@export var focus: TextureProgressBar

func _process(delta: float) -> void:
	if !owner.game_start:
		return
	if abs(focus.value) < focus.focus_thres:
		play(\"0\")
	else:
		# play the distracted progress in chopped steps depending on the frame counte
		stop()
		var worse_progress
		var steps
		if focus.value < 0:
			animation = &\"-1\"
			worse_progress = inverse_lerp(-focus.focus_thres, focus.min_value, focus.value)
			steps = sprite_frames.get_frame_count(&\"-1\")
		else:
			animation = &\"1\"
			worse_progress = inverse_lerp(focus.focus_thres, focus.max_value, focus.value)
			steps = sprite_frames.get_frame_count(&\"1\")
		frame = snappedf(worse_progress, 1/steps)*steps

func _on_timer_timeout() -> void:
	play(\"end\")
"

