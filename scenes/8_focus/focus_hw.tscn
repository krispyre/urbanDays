[sub_resource type="GDScript" id="GDScript_vajo7"]
resource_name = "focusBar"
script/source = "extends TextureProgressBar

var focus_thres = 25
var push_force = 100
var velocity := 0
var gravity:=0
@export var rangeStart: Node2D
@export var rangeEnd: Node2D
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var center = size.x /2
	var unit = size.x/(max_value-min_value)
	#todo the thres should scale
	rangeStart.position = Vector2(center-focus_thres*unit,0)
	rangeEnd.position = Vector2(center+focus_thres*unit,0)

func _process(dt: float) -> void:
	gravity = 50*sign(value-1)
	if Input.is_action_just_pressed(\"left\"):
		velocity = 0
		velocity += -push_force*dt
	elif Input.is_action_just_pressed(\"right\"):
		velocity = 0
		velocity += push_force*dt
	else:
		velocity += gravity*dt
	value += velocity
	
	value = clamp(value, min_value, max_value)
	
	prints(value,velocity, gravity)
	
	#if Input.is_action_just_pressed(\"ui_up\") or Input.is_action_just_pressed(\"action1\"):
		#velocity.z = 0
		#velocity.z -= pushForce * dt
	#elif position.z <= -2:
		#velocity.z += DECCEL * dt
	#else:
		#velocity.z = 0
		#
	#speed_label.text = \"SPEED: \"+str(velocity.z)+\"m/s\\n\"+\"Z: \"+str(position.z)
	#var t = position.z/(bus.position.z-0)#stronger push when closer?
	#pushForce =  lerp(PUSH_FORCE_MAX, PUSH_FORCE_MIN, t)
	#
	##print(pushForce)
#
	#move_and_slide()
"

