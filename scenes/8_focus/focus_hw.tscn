[sub_resource type="GDScript" id="GDScript_dbfos"]
resource_name = "focusHw"
script/source = "extends Level

@export var focus_bar: TextureProgressBar


func _on_timer_timeout() -> void:
	game_start = false
	if abs(focus_bar.value) < focus_bar.focus_thres:
		print(\"owo\")
	else:
		print(\"umu\")
"

[sub_resource type="GDScript" id="GDScript_vajo7"]
resource_name = "focusBar"
script/source = "extends TextureProgressBar

var focus_thres = 25
var push_force = 100
var velocity := 0.0 #make sure its a float BRUH
var gravity:=0.0
var rand_drag:=0.0

var normalized_pos

@export var range: NinePatchRect
@onready var doze_timer: Timer = $dozeOff
@export var focus_pointer: Sprite2D
@export var bg: NinePatchRect
@export var thres_range: NinePatchRect

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	#these are all scaled down by .3
	var center = bg.size.x /2
	var unit = bg.size.x/(max_value-min_value)
	
	var start_x = center-focus_thres*unit
	var end_x = center+focus_thres*unit
	thres_range.position.x = start_x
	thres_range.size.x = end_x-start_x
	
	prints(start_x, end_x, \"sldkjklsd\")
	#positioning the pointer, no scaling
	normalized_pos = ((value-min_value)/(max_value-min_value))
	focus_pointer.position.x = normalized_pos * size.x

func _process(dt: float) -> void:
	if !owner.game_start:
		return
	gravity = randi_range(4,9)*sign(value-1) #todo randomize every interval
	if Input.is_action_just_pressed(\"right\"):
		velocity = 0
		velocity += push_force * dt
	elif Input.is_action_just_pressed(\"left\"):
		velocity = 0
		velocity -= push_force * dt
	else:
		velocity += gravity *dt
		velocity += rand_drag * dt
	
	value += velocity
	value = clamp(value, min_value, max_value)
	
	normalized_pos = ((value-min_value)/(max_value-min_value))
	focus_pointer.position.x = normalized_pos * size.x
	
	#prints(normalized_pos)

func _on_focus_hw_game_start() -> void:
	doze_timer.start()
	
func _on_doze_off_timeout() -> void:
	rand_drag = randi_range(1,10)
	doze_timer.wait_time = snappedf(randfn(1.5,.4), .05)
	#prints(doze_timer.wait_time, rand_drag)

func _on_timer_timeout() -> void:
	focus_pointer.find_child(\"ap\").play(\"blink\")#idc names atp
	doze_timer.stop()
"

