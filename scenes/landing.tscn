[sub_resource type="GDScript" id="GDScript_usvfl"]
resource_name = "startMenu"
script/source = "extends Control

signal item_selected(index:int)
signal item_focused(index:int)

func _ready() -> void:
	var children = get_children()
	for i in range(children.size()):
		children[i].set_focus_mode(FocusMode.FOCUS_ALL)
		children[i].button_down.connect(func(): _on_item_selected(i))
		children[i].focus_entered.connect(func(): _on_item_focused(i))
		children[i].mouse_filter = MouseFilter.MOUSE_FILTER_IGNORE

	# Wait a frame so button sizes are laid out before first focus/move
	await get_tree().process_frame
	children[randi_range(0,children.size()-1)].grab_focus()

#0 indexed
func _on_item_selected(bun_index: int):
	prints(\"bun\", bun_index, \"selected\")
	item_selected.emit(bun_index)

func _on_item_focused(bun_index: int):
	prints(\"bun\", bun_index, \"focused\")
	item_focused.emit(bun_index)
"

