[sub_resource type="GDScript" id="GDScript_esqok"]
script/source = "extends Node2D

signal playerHit
signal playerFall
@onready var anim: AnimationPlayer = $playerBody/anim

func _on_player_body_area_entered(area: Area2D) -> void:
	anim.play(\"hit\")
	area.get_node(\"../sales_animPlayer\").pause()
	playerHit.emit()
"

