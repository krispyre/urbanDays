[sub_resource type="GDScript" id="GDScript_ph3nu"]
resource_name = "tutorial"
script/source = "extends Scene
@export var bgm_player: AudioStreamPlayer

func _unhandled_input(event: InputEvent) -> void:
	if (event.is_action_pressed(\"skip\")):
		bgm_player.seek(bgm_player.get_playback_position()+60/bgm_player.stream.bpm)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	#print(round(bgm_player.get_playback_position()))
	pass


func _on_audio_stream_player_finished() -> void:
	print(\"lol loop ugly\")
	bgm_player.pitch_scale -=.005
	bgm_player.play()
"

