[sub_resource type="GDScript" id="GDScript_ckvwl"]
script/source = "extends RigidBody2D

@export var bed: Marker2D
@export var playuh: Area2D

@export var force_amp = 600
@export var stiffness = 8
@export var c = 1
func _ready():
	prints(playuh.global_position, bed.global_position)
func _physics_process(delta: float) -> void:
	#var inputH = Input.get_axis(\"left\",\"right\")
	#var inputV = Input.get_axis(\"up\",\"down\")
	#go copyupaster
	if Input.is_action_just_pressed(\"right\"):
		linear_velocity = Vector2.ZERO
		apply_impulse(Vector2(force_amp,0))
	elif Input.is_action_just_pressed(\"left\"):
		linear_velocity = Vector2.ZERO
		apply_impulse(Vector2(-force_amp,0))
	elif Input.is_action_just_pressed(\"up\"):
		linear_velocity = Vector2.ZERO
		apply_impulse(Vector2(0,-force_amp))
	elif Input.is_action_just_pressed(\"down\"):
		linear_velocity = Vector2.ZERO
		apply_impulse(Vector2(0,force_amp))
	else:
		# im sorry kenny i forgot about spring physics
		if playuh.global_position.distance_to(bed.global_position)> 10:
			var offset = bed.global_position - playuh.global_position
			var spring = offset * stiffness
			var damper = c * -linear_velocity
			apply_force(spring + damper)
			
		
"

[sub_resource type="GDScript" id="GDScript_gbqnl"]
resource_name = "tutorialControl"
script/source = "extends Area2D

@export var bed: Marker2D
@export var hb: CollisionShape2D
@export var goback: Area2D

@export var spr: Sprite2D

func _process(dt: float) -> void:

	if goback in get_overlapping_areas():
		spr.frame = 1
		if Input.is_action_just_pressed(\"action1\"):
			get_tree().change_scene_to_file(\"res://scenes/landing.tscn\")
	else:
		spr.frame = 0
"

