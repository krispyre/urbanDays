[sub_resource type="GDScript" id="GDScript_gbqnl"]
resource_name = "tutorialControl"
script/source = "extends Area2D

@export var bed: Marker2D
@export var hb: CollisionShape2D
@export var goback: Area2D

var velocity : Vector2
var bedPull: Vector2
var push_force = 300
var pull_strength = 20

func _process(dt: float) -> void:
	bedPull = (bed.position-position).normalized()* (pull_strength)
	#var inputH = Input.get_axis(\"left\",\"right\")
	#var inputV = Input.get_axis(\"up\",\"down\")
	#go copyupaster
	if Input.is_action_just_pressed(\"right\"):
		velocity = Vector2.ZERO
		velocity.x += push_force * dt
	elif Input.is_action_just_pressed(\"left\"):
		velocity = Vector2.ZERO
		velocity.x -= push_force * dt
	elif Input.is_action_just_pressed(\"up\"):
		velocity = Vector2.ZERO
		velocity.y -= push_force * dt
	elif Input.is_action_just_pressed(\"down\"):
		velocity = Vector2.ZERO
		velocity.y += push_force * dt
	else:
		if false:#position.distance_to(bed.position)<10:
			velocity = Vector2.ZERO
		else:
			velocity += bedPull *dt
	
	position += velocity
	
	if goback in get_overlapping_areas() and Input.is_action_just_pressed(\"action1\"):
		get_tree().change_scene_to_file(\"res://scenes/landing.tscn\")
"

